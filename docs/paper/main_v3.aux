\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Observed cross-site degradation of the frozen baseline from the MIMIC-CLIF internal holdout to the three external sites (Rush, Northwestern Medicine, University of Chicago Medicine). Left: for each task a line runs from the internal AUROC to each external site; sepsis and readmission cross below the chance band. Right: the median internal-to-external AUROC drop by task, ordered by magnitude. All four sites are observed. Landmark tasks use the pooled dynamic AUC. Source: FLAIR baseline report artifacts.}}{10}{figure.2}\protected@file@percent }
\newlabel{fig:degradation}{{2}{10}{Observed cross-site degradation of the frozen baseline from the MIMIC-CLIF internal holdout to the three external sites (Rush, Northwestern Medicine, University of Chicago Medicine). Left: for each task a line runs from the internal AUROC to each external site; sepsis and readmission cross below the chance band. Right: the median internal-to-external AUROC drop by task, ordered by magnitude. All four sites are observed. Landmark tasks use the pooled dynamic AUC. Source: FLAIR baseline report artifacts}{figure.2}{}}
