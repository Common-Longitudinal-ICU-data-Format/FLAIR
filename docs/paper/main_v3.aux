\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Observed cross-site degradation of the frozen baseline from the MIMIC-CLIF internal holdout to the first external site (Rush). Left: AUROC for each task falls from internal to external; sepsis crosses below the chance line. Right: the internal-to-external AUROC drop by task, ordered by magnitude. Both panels use only observed data. Source: FLAIR v2 baseline artifacts.}}{10}{figure.2}\protected@file@percent }
\newlabel{fig:degradation}{{2}{10}{Observed cross-site degradation of the frozen baseline from the MIMIC-CLIF internal holdout to the first external site (Rush). Left: AUROC for each task falls from internal to external; sepsis crosses below the chance line. Right: the internal-to-external AUROC drop by task, ordered by magnitude. Both panels use only observed data. Source: FLAIR v2 baseline artifacts}{figure.2}{}}
\@writefile{toc}{\contentsline {paragraph}{Saturation resistance and the regulatory posture.}{10}{section*.8}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Per-site discrimination of the frozen baseline across the CLIF consortium, one panel per task. Each marker is a site's AUROC with a 95\% confidence interval; the dashed line is the MIMIC-CLIF internal reference and the shaded band marks worse-than-chance discrimination. \textbf  {MIMIC-CLIF (blue) and Rush (terracotta) are observed}; \textbf  {open grey markers (Sites C--H) are illustrative projections pending federated runs}, as noted by the watermark. Source: FLAIR v2 baseline artifacts (observed) and \texttt  {flair\_paper\_data.py} (illustrative).}}{11}{figure.3}\protected@file@percent }
\newlabel{fig:forest}{{3}{11}{Per-site discrimination of the frozen baseline across the CLIF consortium, one panel per task. Each marker is a site's AUROC with a 95\% confidence interval; the dashed line is the MIMIC-CLIF internal reference and the shaded band marks worse-than-chance discrimination. \textbf {MIMIC-CLIF (blue) and Rush (terracotta) are observed}; \textbf {open grey markers (Sites C--H) are illustrative projections pending federated runs}, as noted by the watermark. Source: FLAIR v2 baseline artifacts (observed) and \texttt {flair\_paper\_data.py} (illustrative)}{figure.3}{}}
