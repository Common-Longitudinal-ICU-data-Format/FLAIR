\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Federated leaderboard skeleton: XGBoost count-featurization baseline, headline \emph  {mode-matched} AUROC (the deployed, stay-level metric, \S  \ref {sec:eval-modes}) with 1{,}000-iteration bootstrap 95\% CI. MIMIC-CLIF is the internal test split (75/25 hold-out on stitched encounters, \texttt  {hospitalization\_join\_id}, so an encounter never spans train and test); Rush is the first external site, the MIMIC-trained model scored on a deterministic 25\% hold-out of Rush data; remaining site columns read \texttt  {TBD}. Full internal detail, including row-level AUROC and AUPRC, is in Table~\ref {tab:supp-baseline-full}.}}{7}{table.caption.17}\protected@file@percent }
\newlabel{tab:baseline}{{3}{7}{Federated leaderboard skeleton: XGBoost count-featurization baseline, headline \emph {mode-matched} AUROC (the deployed, stay-level metric, \S \ref {sec:eval-modes}) with 1{,}000-iteration bootstrap 95\% CI. MIMIC-CLIF is the internal test split (75/25 hold-out on stitched encounters, \texttt {hospitalization\_join\_id}, so an encounter never spans train and test); Rush is the first external site, the MIMIC-trained model scored on a deterministic 25\% hold-out of Rush data; remaining site columns read \texttt {TBD}. Full internal detail, including row-level AUROC and AUPRC, is in Table~\ref {tab:supp-baseline-full}}{table.caption.17}{}}
\newlabel{sec:eval-modes}{{4}{7}{Evaluation modes}{section*.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {The FLAIR model-to-data loop.} Patient-level data never leaves any site; only a model crosses in and an aggregate report crosses out. \emph  {Develop (central, public):} a model is built against MIMIC-CLIF with \texttt  {flair-baseline train} (cohorts, a 75/25 split on \texttt  {hospitalization\_join\_id}, count features, an XGBoost head) or submitted by the community as a pull request; the Benchmark Committee reviews it for clinical and security soundness. \emph  {Ship:} the FLAIR Portal distributes the approved model folder and code to the 12+ CLIF sites. \emph  {Run locally:} each Site Lead / Data Steward applies it with \texttt  {flair-baseline infer} on the site's own CLIF tables, which writes three site-prefixed folders, and returns only the non-PHI \textbf  {report bundle}, a \emph  {mode-keyed} set of JSONs (\texttt  {discrimination}, \texttt  {calibration}, \texttt  {dca}, \texttt  {fairness}, and, for landmark tasks, \texttt  {leadtime}) plus \texttt  {table1.json} and a suppressed code registry, with cell suppression at $n<10$ --- metrics only, no patient rows. \emph  {Aggregate \& publish:} the Portal pools the per-site reports into the public leaderboard, where the per-site \textbf  {forest plot}, not the pooled scalar, is the headline signal.}}{8}{figure.caption.21}\protected@file@percent }
\newlabel{fig:workflow}{{1}{8}{\textbf {The FLAIR model-to-data loop.} Patient-level data never leaves any site; only a model crosses in and an aggregate report crosses out. \emph {Develop (central, public):} a model is built against MIMIC-CLIF with \texttt {flair-baseline train} (cohorts, a 75/25 split on \texttt {hospitalization\_join\_id}, count features, an XGBoost head) or submitted by the community as a pull request; the Benchmark Committee reviews it for clinical and security soundness. \emph {Ship:} the FLAIR Portal distributes the approved model folder and code to the 12+ CLIF sites. \emph {Run locally:} each Site Lead / Data Steward applies it with \texttt {flair-baseline infer} on the site's own CLIF tables, which writes three site-prefixed folders, and returns only the non-PHI \textbf {report bundle}, a \emph {mode-keyed} set of JSONs (\texttt {discrimination}, \texttt {calibration}, \texttt {dca}, \texttt {fairness}, and, for landmark tasks, \texttt {leadtime}) plus \texttt {table1.json} and a suppressed code registry, with cell suppression at $n<10$ --- metrics only, no patient rows. \emph {Aggregate \& publish:} the Portal pools the per-site reports into the public leaderboard, where the per-site \textbf {forest plot}, not the pooled scalar, is the headline signal}{figure.caption.21}{}}
