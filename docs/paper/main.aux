\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:consortium-sites}{{1}{4}{Federated consortium cohort skeleton (one suppressed \texttt {table1.json} per site, T1 cohort). MIMIC-CLIF is the public development entry point; Rush is the first reporting external site. Remaining sites report at submission, so their cells read \texttt {TBD}. Cell suppression at $n{<}10$ is applied site by site}{table.caption.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces MIMIC-CLIF cohort snapshot per task, written as a suppressed \texttt  {table1.json} by the FLAIR baseline (\texttt  {flair-baseline train}; \texttt  {flair\_benchmark} v0.1.0; HIPAA cell-suppression at $n{<}10$). \emph  {Decision rows} are one-per-stay for T3 (extubation episode) and T5 (ICU readmission, anchored at first-ICU discharge), and one-per-window otherwise (daily at 07:00 local for T1/T2; hourly for T4). Counts are per stitched encounter (\texttt  {hospitalization\_join\_id}; hospitalizations $\le $6\,h apart are merged), so \emph  {ICU encounters} $\le $ the raw hospitalization count. \emph  {Stays ever positive} equals the row-level rate for T3 and T5 because those tasks are one-per-stay. \emph  {SOFA hosp.\ max} is the worst SOFA score across the full hospitalization $[\textit  {admission\_dttm}, \textit  {discharge\_dttm}]$, computed via \texttt  {clifpy}'s polars backend (\texttt  {compute\_sofa\_polars}). Charlson and Elixhauser are computed from \texttt  {HospitalDiagnosis}; 49--54\% of stays are missing comorbidity scores in the MIMIC-CLIF export, a known data-quality gap (Limitations).}}{5}{table.caption.12}\protected@file@percent }
\newlabel{tab:mimic-snapshot}{{2}{5}{MIMIC-CLIF cohort snapshot per task, written as a suppressed \texttt {table1.json} by the FLAIR baseline (\texttt {flair-baseline train}; \texttt {flair\_benchmark} v0.1.0; HIPAA cell-suppression at $n{<}10$). \emph {Decision rows} are one-per-stay for T3 (extubation episode) and T5 (ICU readmission, anchored at first-ICU discharge), and one-per-window otherwise (daily at 07:00 local for T1/T2; hourly for T4). Counts are per stitched encounter (\texttt {hospitalization\_join\_id}; hospitalizations $\le $6\,h apart are merged), so \emph {ICU encounters} $\le $ the raw hospitalization count. \emph {Stays ever positive} equals the row-level rate for T3 and T5 because those tasks are one-per-stay. \emph {SOFA hosp.\ max} is the worst SOFA score across the full hospitalization $[\textit {admission\_dttm}, \textit {discharge\_dttm}]$, computed via \texttt {clifpy}'s polars backend (\texttt {compute\_sofa\_polars}). Charlson and Elixhauser are computed from \texttt {HospitalDiagnosis}; 49--54\% of stays are missing comorbidity scores in the MIMIC-CLIF export, a known data-quality gap (Limitations)}{table.caption.12}{}}
