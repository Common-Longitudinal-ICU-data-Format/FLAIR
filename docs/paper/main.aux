\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces XGBoost count-featurization baseline: full mode-matched per-task metrics on the MIMIC-CLIF internal test split (75/25 hold-out on \texttt  {hospitalization\_join\_id}). $n$ is stays scored; prevalence is the mode-matched event rate; AUROC/AUPRC carry 1{,}000-iteration bootstrap 95\% CIs.}}{17}{table.caption.38}\protected@file@percent }
\newlabel{tab:supp-baseline-full}{{5}{17}{XGBoost count-featurization baseline: full mode-matched per-task metrics on the MIMIC-CLIF internal test split (75/25 hold-out on \texttt {hospitalization\_join\_id}). $n$ is stays scored; prevalence is the mode-matched event rate; AUROC/AUPRC carry 1{,}000-iteration bootstrap 95\% CIs}{table.caption.38}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Per-task ROC, all sites overlaid.} One ROC per task with MIMIC-CLIF (blue) and Rush (terracotta) on the same axes, each legend showing the site AUROC; the dashed diagonal is chance. The external-site curves sit below MIMIC on every task, and the sepsis (T4) Rush curve crosses below chance (AUROC 0.41), the discrimination collapse mode-matched scoring exposes. \emph  {Landmark tasks (T1, T2) pool all 12 lead-time risk sets into one curve} (mean true-positive rate on the shared false-positive-rate grid), so the pooled AUROC here is lower than the lead-0 value reported in Table~\ref {tab:baseline}.}}{19}{figure.caption.40}\protected@file@percent }
\newlabel{fig:supp-roc-pr}{{2}{19}{\textbf {Per-task ROC, all sites overlaid.} One ROC per task with MIMIC-CLIF (blue) and Rush (terracotta) on the same axes, each legend showing the site AUROC; the dashed diagonal is chance. The external-site curves sit below MIMIC on every task, and the sepsis (T4) Rush curve crosses below chance (AUROC 0.41), the discrimination collapse mode-matched scoring exposes. \emph {Landmark tasks (T1, T2) pool all 12 lead-time risk sets into one curve} (mean true-positive rate on the shared false-positive-rate grid), so the pooled AUROC here is lower than the lead-0 value reported in Table~\ref {tab:baseline}}{figure.caption.40}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Reliability (calibration) curves.} Reliability points (bins with $n\ge 10$) against the diagonal, with the logistic recalibration slope/intercept in each title. The episodic tasks have slope $<1$ (\texttt  {scale\_pos\_weight} over-inflates predicted risk); the landmark tasks are closer to calibrated in slope. Peak (T4) omits calibration by design (the peak-trap).}}{20}{figure.caption.41}\protected@file@percent }
\newlabel{fig:supp-calibration}{{3}{20}{\textbf {Reliability (calibration) curves.} Reliability points (bins with $n\ge 10$) against the diagonal, with the logistic recalibration slope/intercept in each title. The episodic tasks have slope $<1$ (\texttt {scale\_pos\_weight} over-inflates predicted risk); the landmark tasks are closer to calibrated in slope. Peak (T4) omits calibration by design (the peak-trap)}{figure.caption.41}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Decision curve analysis (episodic tasks).} Net benefit of the model vs.\ treat-all / treat-none near the rare-event decision region; the red dotted line is the task's clinical threshold. The model beats both defaults across the useful threshold band.}}{21}{figure.caption.42}\protected@file@percent }
\newlabel{fig:supp-dca}{{4}{21}{\textbf {Decision curve analysis (episodic tasks).} Net benefit of the model vs.\ treat-all / treat-none near the rare-event decision region; the red dotted line is the task's clinical threshold. The model beats both defaults across the useful threshold band}{figure.caption.42}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Landmark lead-time views (T1, T2).} AUROC at each lead-time landmark (top), the share of event stays alarmed by lead time (bottom left), and the mean predicted-risk trajectory split by outcome (bottom right). These replace the single operating point for tasks scored as a sequence of daily risk sets.}}{21}{figure.caption.43}\protected@file@percent }
\newlabel{fig:supp-landmark}{{5}{21}{\textbf {Landmark lead-time views (T1, T2).} AUROC at each lead-time landmark (top), the share of event stays alarmed by lead time (bottom left), and the mean predicted-risk trajectory split by outcome (bottom right). These replace the single operating point for tasks scored as a sequence of daily risk sets}{figure.caption.43}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Subgroup AUROC (fairness).} Per-subgroup AUROC across sex, race, ethnicity, and age bins with 95\% CIs; subgroups with $n<10$ are suppressed. Overlapping intervals across subgroups indicate no large discrimination-parity gap at the MIMIC-CLIF entry point.}}{22}{figure.caption.44}\protected@file@percent }
\newlabel{fig:supp-fairness}{{6}{22}{\textbf {Subgroup AUROC (fairness).} Per-subgroup AUROC across sex, race, ethnicity, and age bins with 95\% CIs; subgroups with $n<10$ are suppressed. Overlapping intervals across subgroups indicate no large discrimination-parity gap at the MIMIC-CLIF entry point}{figure.caption.44}{}}
