# Copy to .env and fill. Never commit the real .env.

# Signs the session cookie. Generate: python -c "import secrets; print(secrets.token_hex(32))"
FLAIR_SECRET_KEY=change-me-to-a-long-random-string

# SQLite file (site profiles, users, run status). Mount this path on a volume in prod.
FLAIR_DB_PATH=flair_website.db

# Set true behind HTTPS so the session cookie is marked Secure.
FLAIR_SECURE_COOKIE=false
